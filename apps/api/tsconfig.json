{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "strictPropertyInitialization": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "altcha-lib": [
        "node_modules/altcha-lib/dist/cjs/v2/index.d.ts"
      ],
      "altcha-lib/algorithms/*": [
        "node_modules/altcha-lib/dist/cjs/v2/algorithms/*.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
