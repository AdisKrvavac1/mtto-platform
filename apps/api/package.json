{
  "name": "@mtto/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json && node dist/main.js",
    "db:seed": "node dist/seed.js",
    "render:start": "node dist/seed.js --if-empty && node dist/main.js",
    "test": "tsc -p tsconfig.json && node --test 'dist/**/*.test.js'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:types": "kysely-codegen --dialect postgres --out-file src/db-types.ts --include-pattern \"public.*\" --exclude-pattern \"public.{spatial_ref_sys,geography_columns,geometry_columns}\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1178.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.8.0",
    "@sentry/node": "^11.19.0",
    "altcha-lib": "^2.10.0",
    "bcryptjs": "^3.0.2",
    "kysely": "^0.29.9",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.2",
    "kysely-codegen": "^0.20.0",
    "typescript": "^5.7.0"
  }
}
